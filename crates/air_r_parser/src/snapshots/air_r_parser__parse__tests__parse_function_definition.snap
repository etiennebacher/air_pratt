---
source: crates/air_r_parser/src/parse.rs
expression: "format!(\"{:#?}\", parsed.syntax())"
---
0: R_ROOT@0..12
  0: (empty)
  1: R_EXPRESSION_LIST@0..12
    0: R_FUNCTION_DEFINITION@0..12
      0: FUNCTION_KW@0..8 "function" [] []
      1: R_PARAMETERS@8..10
        0: L_PAREN@8..9 "(" [] []
        1: R_PARAMETER_LIST@9..9
        2: R_PAREN@9..10 ")" [] []
      2: R_DOUBLE_VALUE@10..12
        0: R_DOUBLE_LITERAL@10..12 "1" [Whitespace(" ")] []
  2: EOF@12..12 "" [] []
